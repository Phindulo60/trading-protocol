# Copy to terraform.tfvars and fill in your values
# (terraform.tfvars is .gitignored)

aws_region          = "us-east-1"
telegram_bot_token  = "your-bot-token"
telegram_chat_id    = "your-chat-id"
twelve_data_api_key = "your-twelve-data-key"

# Signal engine config
pairs         = "EURUSD,GBPUSD,AUDUSD,USDCAD,EURJPY,GBPJPY"
feed          = "td"
enable_llm    = true
scan_interval = 300

# Execution bridge (FSP -> mt4-executor). Off unless fsp_execute = "1".
supabase_url         = "https://asaxglwltlybcxlsiyfv.supabase.co"
supabase_service_key = "your-supabase-service-role-key"  # sb_secret_...
fsp_execute          = "0"     # "1" routes alerted signals to the engine
fsp_execute_max_lot  = "0.10"
fsp_execute_strategies = ""    # empty=all; csv to restrict e.g. "SCALP_MR"
fsp_execute_min_equity = "0"   # equity floor; below this the bridge stops trading ("0"=off)
